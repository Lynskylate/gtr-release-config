{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeploymentStack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "service_name",
    "target_group",
    "runtime",
    "service_user",
    "exposure",
    "healthcheck",
    "containers",
    "rollback_history"
  ],
  "properties": {
    "apiVersion": {
      "const": "deploy.lynskylate/v1alpha1"
    },
    "kind": {
      "const": "DeploymentStack"
    },
    "service_name": {
      "type": "string"
    },
    "target_group": {
      "type": "string"
    },
    "runtime": {
      "type": "object"
    },
    "service_user": {
      "type": "string"
    },
    "exposure": {
      "enum": ["none", "tailscale", "envoy"]
    },
    "healthcheck": {
      "type": "object"
    },
    "managed_files": {
      "type": "array"
    },
    "containers": {
      "type": "array",
      "minItems": 1
    },
    "rollback_history": {
      "type": "array"
    },
    "updated_at": {
      "type": "string"
    }
  }
}
