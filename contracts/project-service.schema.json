{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectService",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "service_name",
    "dockerfile",
    "internal_port",
    "healthcheck_path",
    "exposure",
    "env_profile"
  ],
  "properties": {
    "apiVersion": {
      "const": "deploy.lynskylate/v1alpha1"
    },
    "kind": {
      "const": "ProjectService"
    },
    "service_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "dockerfile": {
      "type": "string",
      "minLength": 1
    },
    "internal_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "healthcheck_path": {
      "type": "string",
      "minLength": 1
    },
    "exposure": {
      "enum": ["none", "tailscale", "envoy"]
    },
    "env_profile": {
      "type": "string",
      "minLength": 1
    }
  }
}

